// Employee Console — PostgreSQL 17 schema (PRD §9).
// SQL uses snake_case, the API uses camelCase. Constraints Prisma cannot express
// (identity column, CHECKs, partial unique indexes) live in SQL migrations.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VIEWER
}

enum ReportStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ReportSource {
  MANUAL
  SCHEDULED
}

enum ReportGenerator {
  GEMINI
  TEMPLATE
}

model Department {
  id        String     @id @db.VarChar(20)
  name      String     @unique @db.VarChar(50)
  sortOrder Int        @map("sort_order")
  employees Employee[]

  @@map("departments")
}

model Employee {
  /// GENERATED BY DEFAULT AS IDENTITY (see migration); seed keeps Excel IDs 101–105.
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(100)
  departmentId    String     @map("department_id") @db.VarChar(20)
  salary          Decimal    @db.Decimal(12, 2)
  joinDate        DateTime   @map("join_date") @db.Date
  isActive        Boolean    @default(true) @map("is_active")
  lastUpdatedDate DateTime   @map("last_updated_date") @db.Date
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("employees")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleSub   String    @unique @map("google_sub") @db.VarChar(255)
  email       String    @unique @db.VarChar(320)
  displayName String    @map("display_name") @db.VarChar(200)
  role        Role
  isEnabled   Boolean   @default(true) @map("is_enabled")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  reports     Report[]
  idempotency IdempotencyKey[]

  @@map("users")
}

/// express-session store (connect-pg-simple layout).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "sessions_expire_idx")
  @@map("sessions")
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status         ReportStatus
  snapshot       Json
  narrative      Json?
  requestedBy    String?          @map("requested_by") @db.Uuid
  source         ReportSource
  generationDate DateTime         @map("generation_date") @db.Date
  promptVersion  String           @map("prompt_version") @db.VarChar(50)
  model          String           @db.VarChar(100)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(3)
  deadlineAt     DateTime         @map("deadline_at") @db.Timestamptz(3)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @map("next_attempt_at") @db.Timestamptz(3)
  leaseTokenHash String?          @map("lease_token_hash") @db.VarChar(64)
  leaseExpiresAt DateTime?        @map("lease_expires_at") @db.Timestamptz(3)
  errorCode      String?          @map("error_code") @db.VarChar(50)
  generatedBy    ReportGenerator? @map("generated_by")
  resultHash     String?          @map("result_hash") @db.VarChar(64)
  requester      User?            @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@map("reports")
}

model IdempotencyKey {
  id             BigInt   @id @default(autoincrement())
  scope          String   @db.VarChar(50)
  key            String   @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([scope, actorId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model IntegrationState {
  key              String    @id @db.VarChar(50)
  lastWorkerSeenAt DateTime? @map("last_worker_seen_at") @db.Timestamptz(3)
  flags            Json      @default("{}")
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("integration_state")
}

/// Database purpose marker (demo/test/performance) checked by reset/fixture/perf scripts.
model AppMeta {
  key   String @id @db.VarChar(50)
  value String @db.VarChar(200)

  @@map("app_meta")
}
