// Employee Console — PostgreSQL 17 schema (PRD §9).
// SQL uses snake_case, the API uses camelCase. Constraints Prisma cannot express
// (identity column, CHECKs, trigram index) live in the SQL migrations.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Fixed master list for the Department dropdown, seeded from the Excel data.
model Department {
  id        String     @id @db.VarChar(20)
  name      String     @unique @db.VarChar(50)
  sortOrder Int        @map("sort_order")
  employees Employee[]

  @@map("departments")
}

model Employee {
  /// GENERATED BY DEFAULT AS IDENTITY (see migration); the seed keeps Excel IDs 101–105.
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(100)
  departmentId    String     @map("department_id") @db.VarChar(20)
  salary          Decimal    @db.Decimal(12, 2)
  joinDate        DateTime   @map("join_date") @db.Date
  isActive        Boolean    @default(true) @map("is_active")
  lastUpdatedDate DateTime   @map("last_updated_date") @db.Date
  /// Bumped on every update; clients send it back as If-Match.
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // + employees_name_trgm_idx (GIN on lower(name) gin_trgm_ops) — SQL-only, see migration 20261002000000_perf_indexes
  @@index([departmentId, isActive])
  @@map("employees")
}
