// Employee Console — PostgreSQL 17 schema (PRD §9).
// SQL uses snake_case, the API uses camelCase. Constraints Prisma cannot express
// (identity column, CHECKs, partial unique indexes) live in SQL migrations.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        String     @id @db.VarChar(20)
  name      String     @unique @db.VarChar(50)
  sortOrder Int        @map("sort_order")
  employees Employee[]

  @@map("departments")
}

model Employee {
  /// GENERATED BY DEFAULT AS IDENTITY (see migration); seed keeps Excel IDs 101–105.
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(100)
  departmentId    String     @map("department_id") @db.VarChar(20)
  salary          Decimal    @db.Decimal(12, 2)
  joinDate        DateTime   @map("join_date") @db.Date
  isActive        Boolean    @default(true) @map("is_active")
  lastUpdatedDate DateTime   @map("last_updated_date") @db.Date
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // + employees_name_trgm_idx (GIN on lower(name) gin_trgm_ops) — SQL-only, see migration 20261002000000_perf_indexes
  @@index([departmentId, isActive])
  @@map("employees")
}

model IdempotencyKey {
  id             BigInt   @id @default(autoincrement())
  scope          String   @db.VarChar(50)
  key            String   @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Database purpose marker (demo/test) checked by reset/fixture scripts.
model AppMeta {
  key   String @id @db.VarChar(50)
  value String @db.VarChar(200)

  @@map("app_meta")
}
