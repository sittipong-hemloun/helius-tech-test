# Employee Console — local settings. Copy once: cp .env.example .env
# Local-only values for the Docker PostgreSQL in compose.yaml (bound to 127.0.0.1). Never commit .env.

POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_console_dev

# API tests and Playwright wipe and re-seed this database — keep it separate from DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_console_test
