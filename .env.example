# Employee Console — local development environment (PRD §13.2)
# Copy happens automatically: `pnpm run setup` creates `.env` from this file, generates every
# random local secret, and never overwrites values you already set. Never commit `.env`.
# Values marked EXTERNAL must come from your own accounts — the app never invents them.

# ---------------------------------------------------------------- runtime
APP_ENV=local
NODE_ENV=development
APP_TIMEZONE=Asia/Bangkok
LOG_LEVEL=info

# Browser origin (Next.js). The API is reached through this origin via /api rewrites.
PUBLIC_APP_ORIGIN=http://localhost:3000
# NestJS listener. Next.js proxies /api/* here. Change both if port 3001 is busy on your machine.
PORT=3001
HOST=127.0.0.1
API_INTERNAL_URL=http://localhost:3001

# ---------------------------------------------------------------- database (Docker postgres:17)
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=__generate__
APP_DB_USER=employee_console_app
APP_DB_PASSWORD=__generate__
# Assembled by setup from APP_DB_USER/APP_DB_PASSWORD; edit only for a custom database.
DATABASE_URL=__generate__
# Test/performance runners use their own role (CREATEDB, only throwaway employee_console_test_*/perf DBs).
TEST_DB_USER=employee_console_test
TEST_DB_PASSWORD=__generate__
DB_POOL_MAX=10

# ---------------------------------------------------------------- sessions
SESSION_SECRET=__generate__
SESSION_COOKIE_NAME=employee_console.local.sid

# ---------------------------------------------------------------- Google OIDC (EXTERNAL)
# Create an OAuth 2.0 "Web application" client in Google Cloud Console and register BOTH
# redirect URIs: http://localhost:3000/api/auth/google/callback and
#                http://localhost:3100/api/auth/google/callback (staging)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Comma-separated Google account emails (EXTERNAL). An address may appear in only one list.
ADMIN_EMAILS=
VIEWER_EMAILS=

# ---------------------------------------------------------------- AI reports (n8n + Gemini)
# Keep false until n8n credentials are set and the worker workflow is active.
REPORTS_ENABLED=false
GEMINI_MODEL=gemini-flash-lite-latest
# EXTERNAL: Google AI Studio API key. Imported into n8n / Open WebUI credentials only.
GEMINI_API_KEY=
WORKER_SERVICE_TOKEN=__generate__
SCHEDULER_SERVICE_TOKEN=__generate__
# Where n8n (in Docker) reaches the API. Dev API on the host: http://host.docker.internal:3001/internal/v1
N8N_INTERNAL_API_URL=http://api-staging:3001/internal/v1
N8N_DB_PASSWORD=__generate__
N8N_ENCRYPTION_KEY=__generate__

# ---------------------------------------------------------------- Open WebUI (profile ai-workspace)
WEBUI_SECRET_KEY=__generate__
OPEN_WEBUI_ENABLE_SIGNUP=true

# ---------------------------------------------------------------- Jenkins (profile ci)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=__generate__
# Existing repository URL (EXTERNAL). Empty → the local repo path is used for the job.
JENKINS_GIT_URL=
JENKINS_GIT_BRANCH=main
GIT_CREDENTIAL_ID=

# ---------------------------------------------------------------- test/performance only
# Must stay false outside APP_ENV=test/performance (startup refuses otherwise).
AUTH_FIXTURES_ENABLED=false
PERF_RATE_LIMIT_OVERRIDE=false
