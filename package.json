{
  "name": "employee-console",
  "private": true,
  "version": "1.0.0",
  "description": "Employee Console: Next.js + NestJS + PostgreSQL employee data manager (AI-Augmented Developer test)",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev:up": "docker compose up -d --wait && pnpm db:migrate && pnpm db:seed",
    "dev": "pnpm --parallel --filter @employee-console/api --filter @employee-console/web run dev",
    "down": "docker compose down",
    "db:migrate": "pnpm --filter @employee-console/api run db:migrate",
    "db:seed": "pnpm --filter @employee-console/api run db:seed",
    "db:reset": "pnpm --filter @employee-console/api run db:reset",
    "test:unit": "pnpm --filter @employee-console/api run test:unit && pnpm --filter @employee-console/web run test:unit",
    "test:api": "pnpm --filter @employee-console/api run test:api",
    "test:e2e": "node tests/e2e/run.mjs",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm --filter @employee-console/api --filter @employee-console/web run build"
  }
}
