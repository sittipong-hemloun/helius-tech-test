{
  "components": {
    "schemas": {
      "ChangedMetaDto": {
        "properties": {
          "changed": {
            "description": "false when the PATCH matched the stored values after normalization (no write, same version)",
            "type": "boolean"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "changed"
        ],
        "type": "object"
      },
      "CreateEmployeeDto": {
        "properties": {
          "departmentId": {
            "enum": [
              "engineering",
              "marketing",
              "sales",
              "hr"
            ],
            "example": "engineering",
            "type": "string"
          },
          "isActive": {
            "description": "true = Active, false = In Active",
            "example": true,
            "type": "boolean"
          },
          "joinDate": {
            "example": "2026-09-01",
            "format": "date",
            "type": "string"
          },
          "name": {
            "description": "Trimmed and NFC-normalized; 1–100 code points.",
            "example": "Dana Lee",
            "maxLength": 100,
            "type": "string"
          },
          "salary": {
            "description": "Decimal string, 0–9999999999.99",
            "example": "62000.00",
            "pattern": "^\\d{1,10}(\\.\\d{1,2})?$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "departmentId",
          "salary",
          "joinDate",
          "isActive"
        ],
        "type": "object"
      },
      "DepartmentDto": {
        "properties": {
          "id": {
            "example": "engineering",
            "type": "string"
          },
          "name": {
            "example": "Engineering",
            "type": "string"
          },
          "sortOrder": {
            "example": 1,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder"
        ],
        "type": "object"
      },
      "EmployeeDto": {
        "properties": {
          "departmentId": {
            "enum": [
              "engineering",
              "marketing",
              "sales",
              "hr"
            ],
            "type": "string"
          },
          "departmentName": {
            "example": "Engineering",
            "type": "string"
          },
          "id": {
            "example": 106,
            "type": "number"
          },
          "isActive": {
            "example": true,
            "type": "boolean"
          },
          "joinDate": {
            "example": "2026-09-01",
            "format": "date",
            "type": "string"
          },
          "lastUpdatedDate": {
            "example": "2026-10-01",
            "format": "date",
            "type": "string"
          },
          "name": {
            "example": "Dana Lee",
            "type": "string"
          },
          "salary": {
            "example": "62000.00",
            "type": "string"
          },
          "version": {
            "example": 1,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "departmentId",
          "departmentName",
          "salary",
          "joinDate",
          "isActive",
          "lastUpdatedDate",
          "version"
        ],
        "type": "object"
      },
      "EmployeeListMetaDto": {
        "properties": {
          "page": {
            "example": 1,
            "type": "number"
          },
          "pageSize": {
            "example": 20,
            "type": "number"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          },
          "sortBy": {
            "enum": [
              "id",
              "name",
              "department",
              "joinDate",
              "isActive",
              "lastUpdatedDate",
              "salary"
            ],
            "type": "string"
          },
          "sortOrder": {
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          },
          "total": {
            "example": 5,
            "type": "number"
          },
          "totalPages": {
            "description": "0 when total is 0",
            "example": 1,
            "type": "number"
          }
        },
        "required": [
          "requestId",
          "page",
          "pageSize",
          "total",
          "totalPages",
          "sortBy",
          "sortOrder"
        ],
        "type": "object"
      },
      "ErrorBodyDto": {
        "properties": {
          "code": {
            "example": "VALIDATION_ERROR",
            "type": "string"
          },
          "currentVersion": {
            "description": "VERSION_CONFLICT only",
            "type": "number"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            },
            "type": "array"
          },
          "message": {
            "example": "Please correct the highlighted fields.",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "type": "object"
      },
      "ErrorEnvelopeDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FieldErrorDto": {
        "properties": {
          "code": {
            "example": "DECIMAL_SCALE_EXCEEDED",
            "type": "string"
          },
          "field": {
            "example": "salary",
            "type": "string"
          },
          "message": {
            "example": "Salary must have at most 2 decimal places.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "MetaDto": {
        "properties": {
          "requestId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "requestId"
        ],
        "type": "object"
      },
      "UpdateEmployeeDto": {
        "properties": {
          "departmentId": {
            "enum": [
              "engineering",
              "marketing",
              "sales",
              "hr"
            ],
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "joinDate": {
            "format": "date",
            "type": "string"
          },
          "name": {
            "example": "Dana Lee",
            "maxLength": 100,
            "type": "string"
          },
          "salary": {
            "example": "63000.00",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
