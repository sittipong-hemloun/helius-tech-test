            "enum": [
              "engineering",
              "marketing",
              "sales",
              "hr"
            ],
            "type": "string"
          },
          "departmentName": {
            "example": "Engineering",
            "type": "string"
          },
          "id": {
            "example": 106,
            "type": "number"
          },
          "isActive": {
            "example": true,
            "type": "boolean"
          },
          "joinDate": {
            "example": "2026-09-01",
            "format": "date",
            "type": "string"
          },
          "lastUpdatedDate": {
            "example": "2026-10-01",
            "format": "date",
            "type": "string"
          },
          "name": {
            "example": "Dana Lee",
            "type": "string"
          },
          "salary": {
            "description": "Present for Admin only; the key is omitted for Viewer.",
            "example": "62000.00",
            "type": "string"
          },
          "version": {
            "example": 1,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "departmentId",
          "departmentName",
          "joinDate",
          "isActive",
          "lastUpdatedDate",
          "version"
