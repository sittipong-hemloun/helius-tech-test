{
  "components": {
    "schemas": {
      "BuildDto": {
        "properties": {
          "appVersion": {
            "type": "string"
          },
          "commitSha": {
            "type": "string"
          }
        },
        "required": [
          "commitSha",
          "appVersion"
        ],
        "type": "object"
      },
      "ClaimedReportJobDto": {
        "properties": {
          "attempt": {
            "type": "number"
          },
          "leaseExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "leaseToken": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "promptVersion": {
            "type": "string"
          },
          "reportId": {
            "format": "uuid",
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/SnapshotDto"
          }
        },
        "required": [
          "reportId",
          "leaseToken",
          "leaseExpiresAt",
          "attempt",
          "model",
          "promptVersion",
          "snapshot"
        ],
        "type": "object"
      },
      "CompleteReportJobDto": {
        "properties": {
          "generatedBy": {
            "enum": [
              "GEMINI",
              "TEMPLATE"
            ],
            "type": "string"
          },
          "leaseToken": {
            "type": "string"
          },
          "model": {
            "example": "gemini-3.5-flash-lite",
            "nullable": true,
            "type": "string"
          },
          "narrative": {
            "example": {
              "bullets": [
                "...",
                "...",
                "..."
              ],
              "headline": "ภาพรวมพนักงาน"
            },
            "type": "object"
          },
          "promptVersion": {
            "example": "employee-summary-v1",
            "type": "string"
          }
        },
        "required": [
          "leaseToken",
          "generatedBy",
          "model",
          "promptVersion",
          "narrative"
        ],
        "type": "object"
      },
      "CreateEmployeeDto": {
        "properties": {
          "departmentId": {
            "enum": [
              "engineering",
              "marketing",
              "sales",
              "hr"
            ],
            "example": "engineering",
            "type": "string"
          },
          "isActive": {
            "description": "true = Active, false = In Active",
            "example": true,
            "type": "boolean"
          },
          "joinDate": {
            "example": "2026-09-01",
            "format": "date",
            "type": "string"
          },
          "name": {
            "description": "Trimmed and NFC-normalized; 1–100 code points.",
            "example": "Dana Lee",
            "maxLength": 100,
            "type": "string"
          },
          "salary": {
            "description": "Decimal string, 0–9999999999.99",
            "example": "62000.00",
            "pattern": "^\\d{1,10}(\\.\\d{1,2})?$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "departmentId",
          "salary",
          "joinDate",
          "isActive"
        ],
        "type": "object"
      },
      "CreateReportDto": {
        "properties": {},
        "type": "object"
      },
      "DepartmentDto": {
        "properties": {
          "id": {
            "example": "engineering",
            "type": "string"
          },
          "name": {
            "example": "Engineering",
            "type": "string"
          },
          "sortOrder": {
            "example": 1,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder"
        ],
        "type": "object"
      },
      "EmployeeDto": {
        "properties": {
