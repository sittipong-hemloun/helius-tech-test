{
  "name": "@employee-console/api-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Types generated from the Employee Console OpenAPI document (pnpm openapi:generate).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
