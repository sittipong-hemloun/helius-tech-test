# Employee Console — local staging (production build in Docker, http://localhost:3100).
# Created by `pnpm run setup` with its own secrets; external values are copied from .env
# when empty here. Never commit `.env.staging`.
APP_ENV=staging
NODE_ENV=production
APP_TIMEZONE=Asia/Bangkok
LOG_LEVEL=info
PUBLIC_APP_ORIGIN=http://localhost:3100
STAGING_WEB_PORT=3100

POSTGRES_PASSWORD=__generate__
APP_DB_USER=employee_console_app
APP_DB_PASSWORD=__generate__
DATABASE_URL=__generate__
DB_POOL_MAX=10

SESSION_SECRET=__generate__
SESSION_COOKIE_NAME=employee_console.staging.sid

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3100/api/auth/google/callback
ADMIN_EMAILS=
VIEWER_EMAILS=

REPORTS_ENABLED=false
GEMINI_MODEL=gemini-flash-lite-latest
WORKER_SERVICE_TOKEN=__generate__
SCHEDULER_SERVICE_TOKEN=__generate__

AUTH_FIXTURES_ENABLED=false
PERF_RATE_LIMIT_OVERRIDE=false
